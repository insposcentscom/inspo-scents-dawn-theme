<div class="inspo-footer page-width">
  <div class="inspo-footer__grid">
    <div class="inspo-footer__brand">
      <p class="inspo-footer__logo">INSPO SCENTS</p>
      <p>Luxury-inspired fragrance, made for the way you want to feel.</p>
      <a href="mailto:contact@insposcents.com">contact@insposcents.com</a>
    </div>
    <nav aria-labelledby="inspo-customer-service">
      <h2 id="inspo-customer-service">Customer Service</h2>
      <ul>
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        <li><a href="/policies/refund-policy">Return Policy</a></li>
        <li><a href="/account">Order Status</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="inspo-legal">
      <h2 id="inspo-legal">Legal</h2>
      <ul>
        <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a href="/policies/refund-policy">Return Policy</a></li>
      </ul>
    </nav>
    <div aria-labelledby="inspo-socials">
      <h2 id="inspo-socials">Socials</h2>
      <ul>
        {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}">Instagram</a></li>{%- else -%}<li><span>Instagram</span></li>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}">TikTok</a></li>{%- else -%}<li><span>TikTok</span></li>{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}">Facebook</a></li>{%- else -%}<li><span>Facebook</span></li>{%- endif -%}
      </ul>
    </div>
  </div>
  <div class="inspo-footer__payments" aria-label="Accepted payment methods">
    <span>Secure checkout with</span>
    <ul class="list list-payment" role="list">
      {%- assign inspo_payment_types = 'paypal,apple_pay,google_pay,discover,visa,american_express' | split: ',' -%}
      {%- for type in inspo_payment_types -%}
        <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- assign popup_banner = images['inspo-scents-oil-filled-accords-banner.png'] -%}

<div class="inspo-welcome inspo-welcome--banner" data-inspo-welcome hidden>
  <button class="inspo-welcome__backdrop" type="button" aria-label="Close promotional banner" data-close></button>

  <section class="inspo-welcome__card" role="dialog" aria-modal="true" aria-label="Inspo Scents promotional banner">
    <button class="inspo-welcome__close" type="button" aria-label="Close" data-close>&times;</button>

    <a class="inspo-welcome__banner-link" href="/collections/50-ml-fragrances" aria-label="Shop Inspo Scents fragrances">
      {%- if popup_banner != blank -%}
        {{
          popup_banner
          | image_url: width: 2200
          | image_tag:
            loading: 'eager',
            widths: '480, 750, 990, 1200, 1500, 1800, 2200',
            sizes: '(max-width: 749px) 94vw, min(1100px, 94vw)',
            class: 'inspo-welcome__image',
            alt: 'Inspo Scents luxury-inspired fragrance banner'
        }}
      {%- else -%}
        <img
          class="inspo-welcome__image"
          src="{{ 'inspo-scents-oil-filled-accords-banner.png' | file_img_url: 'master' }}"
          alt="Inspo Scents luxury-inspired fragrance banner"
          loading="eager"
          width="2060"
          height="763"
        >
      {%- endif -%}
    </a>
  </section>
</div>

<style>
  .inspo-welcome--banner .inspo-welcome__card {
    display:block;
    width:min(1100px,94vw);
    max-height:92vh;
    overflow:hidden;
    border:1px solid rgba(182,138,58,.18);
    border-radius:1.2rem;
    background:#e9dec8;
    box-shadow:0 8px 24px rgba(0,0,0,.14);
  }
  .inspo-welcome--banner .inspo-welcome__banner-link {
    display:block;
    width:100%;
    line-height:0;
  }
  .inspo-welcome--banner .inspo-welcome__image {
    display:block;
    width:100%;
    height:auto;
    max-height:88vh;
    min-height:0;
    object-fit:contain;
    object-position:center;
    background:#e9dec8;
  }
  .inspo-welcome--banner .inspo-welcome__close {
    right:.8rem;
    top:.8rem;
    background:rgba(255,255,255,.9);
    box-shadow:0 2px 8px rgba(0,0,0,.1);
  }
  .inspo-hero__quote p {
    text-shadow:0 1px 6px rgba(20,13,7,.12)!important;
  }
  @media(max-width:749px) {
    .inspo-welcome--banner {
      padding:.6rem;
    }
    .inspo-welcome--banner .inspo-welcome__card {
      width:96vw;
      max-height:94vh;
      overflow:hidden;
      border-radius:.9rem;
      box-shadow:0 6px 18px rgba(0,0,0,.12);
    }
    .inspo-welcome--banner .inspo-welcome__image {
      width:100%;
      height:auto;
      max-height:90vh;
      object-fit:contain;
      object-position:center;
    }
  }
</style>

<script>
(() => {
  const popup = document.querySelector('[data-inspo-welcome]');
  if (!popup || popup.dataset.ready === 'true') return;
  popup.dataset.ready = 'true';

  const open = () => {
    popup.hidden = false;
    requestAnimationFrame(() => popup.classList.add('is-visible'));
    document.documentElement.classList.add('inspo-popup-open');
  };

  const close = () => {
    popup.classList.remove('is-visible');
    document.documentElement.classList.remove('inspo-popup-open');
    setTimeout(() => { popup.hidden = true; }, 220);
  };

  popup.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', close));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !popup.hidden) close();
  });

  setTimeout(open, 650);
})();
</script>

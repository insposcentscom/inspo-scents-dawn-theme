{%- assign popup_banner = images['inspo-scents-oil-filled-accords-banner.png'] -%}
<div class="inspo-welcome" data-inspo-welcome data-force-open="{% if form.posted_successfully? or form.errors %}true{% else %}false{% endif %}" hidden>
  <button class="inspo-welcome__backdrop" type="button" aria-label="Close welcome offer" data-close></button>
  <section class="inspo-welcome__card" role="dialog" aria-modal="true" aria-labelledby="InspoWelcomeTitle">
    <button class="inspo-welcome__close" type="button" aria-label="Close" data-close>&times;</button>

    <div class="inspo-welcome__visual" aria-hidden="true">
      {%- if popup_banner != blank -%}
        {{ popup_banner | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 750, 1100, 1400, 1600', sizes: '(max-width: 749px) 96vw, min(760px, 94vw)', class: 'inspo-welcome__image', alt: '' }}
      {%- else -%}
        <img class="inspo-welcome__image" src="{{ 'inspo-scents-oil-filled-accords-banner.png' | file_img_url: 'master' }}" alt="" loading="eager" width="2060" height="763">
      {%- endif -%}
    </div>

    <div class="inspo-welcome__promo">
      {% form 'customer', id: 'InspoWelcomeForm', class: 'inspo-welcome__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,welcome10,new-customer-offer">

        {% if form.posted_successfully? %}
          <p class="inspo-welcome__eyebrow">WELCOME TO INSPO SCENTS</p>
          <h2 id="InspoWelcomeTitle" class="inspo-welcome__title">Your 10% off is unlocked.</h2>
          <p class="inspo-welcome__copy">Use your first-order code below at checkout. It is valid for eligible new customers and can be redeemed once per customer.</p>
          <div class="inspo-welcome__code-row">
            <span class="inspo-welcome__code" data-welcome-code>WELCOME10</span>
            <button class="inspo-welcome__copy-button" type="button" data-copy-code>Copy code</button>
          </div>
          <a class="inspo-welcome__shop-button" href="/collections/50-ml-fragrances">Shop fragrances</a>
          <p class="inspo-welcome__success-note" role="status">Your email was added successfully.</p>
        {% else %}
          <p class="inspo-welcome__eyebrow">NEW CUSTOMER OFFER</p>
          <h2 id="InspoWelcomeTitle" class="inspo-welcome__title">Take 10% off your first order.</h2>
          <p class="inspo-welcome__copy">Join the Inspo Scents list and we’ll unlock your first-order discount code instantly.</p>

          {% if form.errors %}
            <div class="inspo-welcome__errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="inspo-welcome__field-row">
            <label class="visually-hidden" for="InspoWelcomeEmail">Email address</label>
            <input id="InspoWelcomeEmail" class="inspo-welcome__email" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="Enter your email address" autocomplete="email" autocapitalize="off" required>
            <button class="inspo-welcome__submit" type="submit">Unlock 10% off</button>
          </div>
          <p class="inspo-welcome__fine-print">For first-time customers. By signing up, you agree to receive Inspo Scents marketing emails. You can unsubscribe anytime.</p>
        {% endif %}
      {% endform %}
    </div>
  </section>
</div>

<script>
(() => {
  const popup = document.querySelector('[data-inspo-welcome]');
  if (!popup || popup.dataset.ready === 'true') return;
  popup.dataset.ready = 'true';

  const open = () => {
    popup.hidden = false;
    requestAnimationFrame(() => popup.classList.add('is-visible'));
    document.documentElement.classList.add('inspo-popup-open');
  };

  const close = () => {
    popup.classList.remove('is-visible');
    document.documentElement.classList.remove('inspo-popup-open');
    setTimeout(() => { popup.hidden = true; }, 220);
  };

  popup.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', close));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !popup.hidden) close(); });

  const copyButton = popup.querySelector('[data-copy-code]');
  const code = popup.querySelector('[data-welcome-code]');
  if (copyButton && code) {
    copyButton.addEventListener('click', async () => {
      const value = code.textContent.trim();
      try {
        await navigator.clipboard.writeText(value);
        copyButton.textContent = 'Copied';
      } catch (error) {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(code);
        selection.removeAllRanges();
        selection.addRange(range);
        copyButton.textContent = 'Select & copy';
      }
    });
  }

  if (popup.dataset.forceOpen === 'true') open();
  else setTimeout(open, 650);
})();
</script>
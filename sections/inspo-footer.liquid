<footer class="inspo-footer">
  <div class="inspo-footer__accords"><img src="https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-scents-image-5-accords-footer.png?v=1789428462" width="2048" height="768" loading="lazy" alt="Bergamot, pear, blackberry, amber and woods"><div><p>Crafted by note. Chosen by feeling.</p><h2>Fresh brightness. Warm depth. An unforgettable trail.</h2></div></div>
  <div class="page-width inspo-footer__grid">
    <div class="inspo-footer__brand">
      <p>Luxury-inspired fragrance, thoughtfully priced.</p>
      <a href="mailto:contact@insposcents.com">contact@insposcents.com</a>
    </div>
    <div class="inspo-footer__group">
      <h3>Legal</h3>
      <div class="inspo-footer__links"><a href="/pages/return-policy">Return Policy</a><a href="/pages/terms-and-conditions">Terms &amp; Conditions</a><a href="/policies/privacy-policy">Privacy Policy</a><a href="/pages/data-sharing-opt-out">Privacy Choices</a></div>
    </div>
    <div class="inspo-footer__group">
      <h3>Customer Service</h3>
      <div class="inspo-footer__links"><a href="/pages/contact">Contact Us</a><a href="/pages/return-policy">Order Issues</a>{%- if shop.customer_accounts_enabled -%}<a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.storefront_login_url }}{%- endif -%}" rel="nofollow">{%- if customer -%}My account{%- else -%}Sign in / Create account{%- endif -%}</a>{%- endif -%}</div>
    </div>
    <div class="inspo-footer__group inspo-footer__socials">
      <h3>Socials</h3>
      <div class="inspo-footer__social-row"><span class="inspo-footer__social-icon" role="img" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.25"></circle><circle cx="17.4" cy="6.7" r="1"></circle></svg></span><span class="inspo-footer__social-icon" role="img" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 3v11.1a4.6 4.6 0 1 1-4-4.56v3.1a1.55 1.55 0 1 0 1 1.46V3h3c.3 2.2 1.55 3.55 3.8 4.05v3.05a8.25 8.25 0 0 1-3.8-1.35"></path></svg></span><span class="inspo-footer__social-icon" role="img" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h2.8l.42-3H14V8.1c0-.87.24-1.46 1.62-1.46h1.73V3.96a23.3 23.3 0 0 0-2.52-.13c-2.5 0-4.2 1.52-4.2 4.32V10H7.8v3h2.83v8z"></path></svg></span></div>
    </div>
  </div>
  <div class="page-width inspo-footer__payments" aria-label="Accepted payment methods"><span class="inspo-footer__payment-mark">{{ 'paypal' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'apple_pay' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'google_pay' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'discover' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'visa' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'american_express' | payment_type_svg_tag }}</span></div>
  <div class="page-width inspo-footer__bottom"><p>© {{ 'now' | date: '%Y' }} Inspo Scents</p><p class="inspo-footer__disclaimer">Our fragrances are original blends inspired by luxury scent profiles. Inspo Scents is not affiliated with, endorsed by, or connected to any designer or luxury brand. All trademarks and brand names are the property of their respective owners and are used only for scent-comparison purposes.</p></div>
</footer>
{% stylesheet %}
.inspo-footer{background:#100e0b;color:#eee3d0;text-align:center}.inspo-footer__accords{position:relative;overflow:hidden;min-height:280px;display:grid;place-items:center;text-align:center}.inspo-footer__accords img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.52}.inspo-footer__accords:after{content:"";position:absolute;inset:0;background:rgba(8,8,7,.42)}.inspo-footer__accords>div{position:relative;z-index:1;max-width:760px;padding:4rem 2rem}.inspo-footer__accords p{color:#d6bc85;font-size:1.05rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.inspo-footer__accords h2{margin:.7rem 0;color:#fff8ec;font-size:clamp(2.8rem,5vw,5rem);line-height:1.05}.inspo-footer__grid{display:flex;max-width:980px;flex-direction:column;align-items:center;gap:2.2rem;padding-top:3.2rem;padding-bottom:2.4rem}.inspo-footer__brand,.inspo-footer__group{flex:0 0 100%!important;width:100%!important;max-width:none!important;text-align:center}.inspo-footer__brand p{margin:0 0 .65rem;font-size:1.45rem}.inspo-footer h3{margin:0 0 .8rem;color:#d6bc85}.inspo-footer a{color:#eee3d0;text-decoration:none}.inspo-footer a:hover{text-decoration:underline}.inspo-footer__links,.inspo-footer__social-row{display:flex!important;width:100%!important;flex-flow:row wrap!important;justify-content:center!important;align-items:center!important;gap:.65rem 1.8rem!important}.inspo-footer__links a{display:inline-flex!important;margin:0!important;white-space:nowrap}.inspo-footer__social-icon{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;color:#d6bc85}.inspo-footer__social-icon svg{width:26px;height:26px;fill:currentColor;stroke:currentColor;stroke-width:1.6}.inspo-footer__social-icon:first-of-type svg{fill:none}.inspo-footer__payments{display:flex!important;flex-direction:row!important;flex-wrap:wrap!important;justify-content:center!important;align-items:center!important;gap:8px!important;padding-top:1.8rem;border-top:1px solid #3a3125}.inspo-footer__payment-mark{display:flex!important;flex:0 1 44px!important;width:44px!important;min-width:0!important;margin:0!important}.inspo-footer__payment-mark svg{display:block!important;width:100%!important;height:auto!important;margin:0!important}.inspo-footer__bottom{padding-top:1.4rem;padding-bottom:1.8rem;color:#b8aa94;font-size:1.2rem;text-align:center}
@media(max-width:749px){.inspo-footer__accords{min-height:150px}.inspo-footer__accords img{object-position:center}.inspo-footer__accords>div{padding:2.4rem 1.4rem}.inspo-footer__accords h2{font-size:2.4rem}.inspo-footer__grid{gap:1.65rem;padding-top:2.2rem;padding-bottom:1.8rem}.inspo-footer__brand p{font-size:1.25rem}.inspo-footer__grid h3{font-size:1.2rem}.inspo-footer__links{gap:.5rem 1.15rem}.inspo-footer__links a{font-size:1.05rem;line-height:1.35;overflow-wrap:anywhere}.inspo-footer__payments{gap:6px!important;padding-top:1.2rem}.inspo-footer__payment-mark{flex-basis:38px!important;width:38px!important}.inspo-footer__bottom{padding-top:1.2rem;padding-bottom:1.4rem}}
.inspo-footer__bottom p{margin:.35rem auto}.inspo-footer__disclaimer{max-width:78rem;font-size:1rem;line-height:1.45}
{% endstylesheet %}
{% schema %}{"name":"Inspo footer","settings":[],"presets":[{"name":"Inspo footer"}]}{% endschema %}

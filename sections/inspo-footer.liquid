<footer class="inspo-footer">
  <div class="inspo-footer__accords"><img src="https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-scents-image-5-accords-footer.png?v=1789428462" width="2048" height="768" loading="lazy" alt="Bergamot, pear, blackberry, amber and woods"><div><p>Crafted by note. Chosen by feeling.</p><h2>Fresh brightness. Warm depth. An unforgettable trail.</h2></div></div>
  <div class="page-width inspo-footer__grid"><div class="inspo-footer__brand"><h2>Inspo Scents</h2><p>Luxury-inspired fragrance, thoughtfully priced.</p><a href="mailto:contact@insposcents.com">contact@insposcents.com</a></div><div class="inspo-footer__group"><h3>Legal</h3><a href="/pages/return-policy">Return Policy</a><a href="/pages/terms-and-conditions">Terms &amp; Conditions</a><a href="/pages/data-sharing-opt-out">Privacy Choices</a></div><div class="inspo-footer__group"><h3>Customer Service</h3><a href="/pages/contact">Contact Us</a><a href="/pages/return-policy">Order Issues</a><a href="/account">Sign in / Create account</a></div><div class="inspo-footer__group"><h3>Socials</h3><span>Instagram</span><span>TikTok</span><span>Facebook</span></div></div>
  <div class="page-width inspo-footer__payments" aria-label="Accepted payment methods"><span class="inspo-footer__payment-mark">{{ 'paypal' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'apple_pay' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'google_pay' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'discover' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'visa' | payment_type_svg_tag }}</span><span class="inspo-footer__payment-mark">{{ 'american_express' | payment_type_svg_tag }}</span></div>
  <div class="page-width inspo-footer__bottom">© {{ 'now' | date: '%Y' }} Inspo Scents</div>
</footer>
{% stylesheet %}
.inspo-footer{background:#100e0b;color:#eee3d0}.inspo-footer__accords{position:relative;overflow:hidden;min-height:280px;display:grid;place-items:center;text-align:center}.inspo-footer__accords img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.52}.inspo-footer__accords:after{content:"";position:absolute;inset:0;background:rgba(8,8,7,.42)}.inspo-footer__accords>div{position:relative;z-index:1;max-width:760px;padding:4rem 2rem}.inspo-footer__accords p{color:#d6bc85;font-size:1.05rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.inspo-footer__accords h2{margin:.7rem 0;color:#fff8ec;font-size:clamp(2.8rem,5vw,5rem);line-height:1.05}.inspo-footer__grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:3rem;padding-top:4rem;padding-bottom:3rem}.inspo-footer h2,.inspo-footer h3{color:#d6bc85;margin:0 0 1rem}.inspo-footer a,.inspo-footer span{display:block;color:#eee3d0;text-decoration:none;margin:.65rem 0}.inspo-footer a:hover{text-decoration:underline}.inspo-footer__payments{display:flex;flex-wrap:wrap;gap:.6rem;padding-top:2rem;border-top:1px solid #3a3125}.inspo-footer__payments svg{width:44px;height:auto}.inspo-footer__bottom{padding-top:2rem;padding-bottom:2rem;color:#b8aa94;font-size:1.2rem}
@media(max-width:749px){.inspo-footer__accords{min-height:150px}.inspo-footer__accords img{object-position:center}.inspo-footer__accords>div{padding:2.4rem 1.4rem}.inspo-footer__accords h2{font-size:2.4rem}.inspo-footer__grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding-top:2.2rem;padding-bottom:1.8rem}.inspo-footer__grid>div:first-child{grid-column:1/-1}.inspo-footer__grid h3{font-size:1.2rem}.inspo-footer__grid a,.inspo-footer__grid span{font-size:1.05rem;line-height:1.3;margin:.45rem 0;overflow-wrap:anywhere}.inspo-footer__payments{flex-wrap:nowrap;justify-content:center;align-items:center;gap:.35rem;overflow:hidden;padding-top:1.2rem}.inspo-footer__payments svg{flex:1 1 0;width:auto;min-width:0;max-width:38px;height:auto}.inspo-footer__bottom{padding-top:1.2rem;padding-bottom:1.4rem}}
.inspo-footer__payments{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;justify-content:center!important;align-items:center!important;gap:6px!important;overflow:hidden!important}.inspo-footer__payment-mark{display:flex!important;flex:0 1 44px!important;width:44px!important;min-width:0!important;margin:0!important}.inspo-footer__payment-mark svg{display:block!important;width:100%!important;height:auto!important;margin:0!important}
@media(max-width:749px){.inspo-footer__grid{display:flex!important;flex-direction:column!important;gap:1.4rem!important}.inspo-footer__group{display:flex!important;flex-flow:row wrap!important;align-items:center!important;gap:.55rem 1.2rem!important}.inspo-footer__group h3{flex:0 0 100%;margin:0!important}.inspo-footer__group a,.inspo-footer__group span{display:inline-flex!important;margin:0!important;white-space:nowrap}.inspo-footer__payments{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;justify-content:center!important;gap:6px!important}.inspo-footer__payment-mark{flex:0 1 38px!important;width:38px!important}}
{% endstylesheet %}
{% schema %}{"name":"Inspo footer","settings":[],"presets":[{"name":"Inspo footer"}]}{% endschema %}

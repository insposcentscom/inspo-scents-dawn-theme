<section class="inspo-drop-hero" aria-label="Inspo Scents Drop 1">
  <h1 class="visually-hidden">Inspo Scents — Drop 1</h1>
  <picture class="inspo-drop-hero__picture">
    <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-drop-1-mobile-steel.png?v=1791275095&width=750">
    <img class="inspo-drop-hero__image" src="https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-drop-1-desktop-steel.png?v=1791275073&width=2048"
      alt="Inspo Scents Drop 1 — Amber Nocturne, Bad Intentions, Soft Obsession and No One’s Secret on brushed steel platforms."
      width="2048" height="683" loading="eager" fetchpriority="high">
  </picture>
</section>
{% stylesheet %}
.inspo-drop-hero { width:100%; background:#1b1710; }
.inspo-drop-hero__picture { display:block; width:100%; }
.inspo-drop-hero__image { display:block; width:100%; height:auto; }
@media(max-width:749px) {
  .inspo-drop-hero { height:calc(100svh - var(--inspo-opening-header-height, 0px)); min-height:320px; }
  .inspo-drop-hero__picture { height:100%; }
  .inspo-drop-hero__image { width:100%; height:100%; object-fit:contain; object-position:center; }
}
{% endstylesheet %}
<script>
(() => {
  const root = document.documentElement;
  const header = document.querySelector('.shopify-section-group-header-group.section-header');
  const announcement = document.querySelector('.shopify-section-group-header-group.announcement-bar-section');
  const elements = [header, announcement].filter(Boolean);
  const update = () => {
    const height = elements.reduce((sum, element) => sum + element.getBoundingClientRect().height, 0);
    root.style.setProperty('--inspo-opening-header-height', height + 'px');
  };
  update();
  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(update);
    elements.forEach(element => observer.observe(element));
    window.addEventListener('pagehide', () => observer.disconnect(), {once:true});
  }
})();
</script>
{% schema %}
{
  "name":"Inspo Scents Drop 1 hero",
  "tag":"section",
  "class":"section-inspo-hero",
  "settings":[],
  "presets":[{"name":"Inspo Scents Drop 1 hero"}]
}
{% endschema %}

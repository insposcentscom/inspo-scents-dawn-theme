{%- comment -%}
  Inspo Scents homepage hero.
  Keeps the full fragrance artwork visible on desktop and mobile and overlays the approved quote only.
{%- endcomment -%}

{%- assign inspo_hero_image = images['inspo-scents-image-6-hero.png'] -%}

<section class="inspo-hero" aria-label="Inspo Scents luxury-inspired fragrance">
  <div class="inspo-hero__frame">
    {%- if inspo_hero_image != blank -%}
      {{
        inspo_hero_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480, 750, 990, 1200, 1500, 1800, 2200, 2400',
          sizes: '100vw',
          class: 'inspo-hero__image',
          alt: 'Inspo Scents perfume bottles surrounded by bergamot, fruit and fine woods'
      }}
    {%- else -%}
      <img
        class="inspo-hero__image"
        src="{{ 'inspo-scents-image-6-hero.png' | file_img_url: 'master' }}"
        alt="Inspo Scents perfume bottles surrounded by bergamot, fruit and fine woods"
        loading="eager"
        width="2060"
        height="763"
      >
    {%- endif -%}

    <div class="inspo-hero__quote">
      <h1>Smell expensive.<span>Spend less.</span></h1>
      <p>Luxury-inspired fragrances without the luxury markup.</p>
      <a class="inspo-hero__cta" href="#shop-fragrances" data-inspo-shop-now>Shop now</a>
    </div>
  </div>
</section>

{% stylesheet %}
.inspo-hero{background:#1d130c}.inspo-hero__frame{position:relative;overflow:hidden;max-width:1600px;margin:0 auto}.inspo-hero__image{display:block;width:100%;height:auto;object-fit:contain}.inspo-hero__quote{position:absolute;top:50%;left:clamp(2rem,6vw,8rem);max-width:min(42rem,38vw);transform:translateY(-50%);color:#fff6e6;text-shadow:0 2px 12px rgba(0,0,0,.26)}.inspo-hero__quote h1{margin:0;color:#fff6e6;font-size:clamp(2.6rem,4vw,5.6rem);font-weight:400;line-height:1.04}.inspo-hero__quote h1 span{display:block;color:#e7c783}.inspo-hero__quote p{margin:1rem 0 0;max-width:40rem;font-size:clamp(1.2rem,1.5vw,1.7rem);line-height:1.45}
.inspo-hero__quote h1{font-size:clamp(2.6rem,3.2vw,4.4rem)!important;text-transform:uppercase}.inspo-hero__quote p{font-size:clamp(1.2rem,1.2vw,1.6rem)!important;line-height:1.45!important}.inspo-hero__cta{display:inline-flex;margin-top:1.4rem;padding:1rem 1.7rem;border:1px solid #e7c783;background:rgba(23,17,12,.82);color:#fff6e6;font-size:1.05rem;font-weight:700;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.inspo-hero__cta:hover,.inspo-hero__cta:focus-visible{background:#e7c783;color:#21180f}
@media(max-width:749px){.inspo-hero__frame{position:relative}.inspo-hero__quote{position:absolute;top:50%;left:1.4rem;width:54%;max-width:22rem;padding:0;transform:translateY(-50%);text-align:left;text-shadow:0 2px 10px rgba(0,0,0,.5)}.inspo-hero__quote h1{font-size:clamp(1.8rem,5.4vw,2.3rem)!important;line-height:1.04}.inspo-hero__quote p{margin:.65rem 0 0;max-width:20rem;font-size:clamp(.92rem,2.7vw,1.08rem)!important;line-height:1.3!important}.inspo-hero__image{display:block;width:100%;height:auto}}
{% endstylesheet %}

<script>
  document.querySelector('[data-inspo-shop-now]')?.addEventListener('click', (event) => {
    const products = document.querySelector('[id^="shop-fragrances-"]');
    if (!products) return;
    event.preventDefault();
    products.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

{% schema %}
{
  "name": "Inspo Scents hero",
  "tag": "section",
  "class": "section-inspo-hero",
  "settings": [],
  "presets": [
    {
      "name": "Inspo Scents hero"
    }
  ]
}
{% endschema %}

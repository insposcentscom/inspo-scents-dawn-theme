{%- comment -%}
  Inspo Scents homepage hero.
  Keeps the full fragrance artwork visible on desktop and mobile and overlays the approved copy only.
{%- endcomment -%}

{%- assign inspo_hero_image = images['inspo-scents-image-6-hero.png'] -%}

<section class="inspo-hero" aria-label="Inspo Scents luxury-inspired fragrance">
  <div class="inspo-hero__frame">
    {%- if inspo_hero_image != blank -%}
      {{
        inspo_hero_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480, 750, 990, 1200, 1500, 1800, 2200, 2400',
          sizes: '100vw',
          class: 'inspo-hero__image',
          alt: 'Inspo Scents perfume bottles surrounded by bergamot, fruit and fine woods'
      }}
    {%- else -%}
      <img
        class="inspo-hero__image"
        src="{{ 'inspo-scents-image-6-hero.png' | file_img_url: 'master' }}"
        alt="Inspo Scents perfume bottles surrounded by bergamot, fruit and fine woods"
        loading="eager"
        width="2060"
        height="763"
      >
    {%- endif -%}

    <div class="inspo-hero__quote">
      <h1>Luxury-inspired scents.<span>Without the luxury markup.</span></h1>
      <p>Premium fragrances inspired by iconic scent profiles—without the designer price tag.</p>
    </div>
  </div>
</section>

{% stylesheet %}
.inspo-hero{background:#1d130c}.inspo-hero__frame{position:relative;overflow:hidden;max-width:1600px;margin:0 auto}.inspo-hero__image{display:block;width:100%;height:auto;object-fit:contain}.inspo-hero__quote{position:absolute;top:50%;left:clamp(1.5rem,5vw,7rem);z-index:2;width:min(40rem,40vw);max-width:40vw;box-sizing:border-box;transform:translateY(-50%);color:#fff6e6;text-align:left;text-shadow:0 2px 12px rgba(0,0,0,.32)}.inspo-hero__quote h1{margin:0;color:#fff6e6;font-size:clamp(2.4rem,3.2vw,4.4rem);font-weight:400;line-height:1.06;overflow-wrap:normal;word-break:normal}.inspo-hero__quote h1 span{display:block;color:#e7c783}.inspo-hero__quote p{margin:.9rem 0 0;max-width:38rem;font-size:clamp(1.1rem,1.2vw,1.6rem);line-height:1.42}
@media(max-width:989px){.inspo-hero__quote{left:clamp(1.25rem,4vw,3rem);width:44%;max-width:44%}.inspo-hero__quote h1{font-size:clamp(2rem,4.2vw,3.2rem)}.inspo-hero__quote p{font-size:clamp(1rem,1.8vw,1.3rem)}}
@media(max-width:749px){.inspo-hero__frame{position:relative}.inspo-hero__image{display:block;width:100%;height:auto;object-fit:contain}.inspo-hero__quote{position:absolute;top:50%;left:1rem;width:50%;max-width:50%;padding:0;box-sizing:border-box;transform:translateY(-50%);text-align:left;text-shadow:0 2px 10px rgba(0,0,0,.55)}.inspo-hero__quote h1{font-size:clamp(1.55rem,5vw,2.15rem);line-height:1.05}.inspo-hero__quote p{margin:.55rem 0 0;max-width:100%;font-size:clamp(.78rem,2.45vw,1rem);line-height:1.28}}
@media(max-width:420px){.inspo-hero__quote{left:.8rem;width:52%;max-width:52%}.inspo-hero__quote h1{font-size:clamp(1.35rem,4.9vw,1.9rem)}.inspo-hero__quote p{font-size:clamp(.72rem,2.3vw,.9rem);line-height:1.25}}
{% endstylesheet %}

{% schema %}
{
  "name": "Inspo Scents hero",
  "tag": "section",
  "class": "section-inspo-hero",
  "settings": [],
  "presets": [
    {
      "name": "Inspo Scents hero"
    }
  ]
}
{% endschema %}

    .inspo-result{text-align:center}.inspo-result__note{margin:-1.2rem auto 2.4rem;opacity:.72}.inspo-result__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin:0 0 2.6rem}.inspo-result-card{min-width:0;color:inherit;display:flex;flex-direction:column;gap:.65rem;text-decoration:none;text-align:left}.inspo-result-card__media{display:block;overflow:hidden;border-radius:1.2rem;background:#efe7dc;aspect-ratio:4/5}.inspo-result-card__media img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;padding:.7rem}.inspo-result-card__title{font-weight:700;font-size:1.45rem;line-height:1.25}.inspo-result-card strong{font-size:1.25rem}
  .inspo-accords{position:relative;overflow:hidden;background:#21180f;color:#fff8ec;padding:clamp(5rem,8vw,9rem) 0;text-align:center}.inspo-accords__veil{position:absolute;inset:0;background:radial-gradient(circle at 18% 24%,rgba(231,174,83,.18),transparent 26%),radial-gradient(circle at 78% 72%,rgba(146,78,42,.22),transparent 30%);opacity:.8}.inspo-accords__content{position:relative;z-index:1;max-width:1000px}.inspo-accords h2{margin:1rem auto 3rem;color:#fff8ec;font-size:clamp(3rem,5vw,5.7rem);line-height:1.05}.inspo-note-scenes{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;opacity:.42}.inspo-note-scene{position:relative;display:block;aspect-ratio:16/8;border-radius:1.4rem;overflow:hidden;border:1px solid rgba(255,255,255,.12)}.inspo-note-scene--bergamot{background:radial-gradient(circle at 35% 55%,#d9b34c 0 14%,transparent 15%),linear-gradient(145deg,#725f2b,#243a28)}.inspo-note-scene--fruit{background:radial-gradient(circle at 35% 55%,#b7333e 0 15%,transparent 16%),radial-gradient(circle at 63% 45%,#d99138 0 13%,transparent 14%),linear-gradient(145deg,#5b3327,#2b1b19)}.inspo-note-scene--amber{background:radial-gradient(circle at 50% 55%,#d8903c 0 16%,transparent 17%),linear-gradient(145deg,#6f3f1f,#24140d)}.inspo-note-scene--woods{background:linear-gradient(105deg,transparent 35%,#805a37 36% 46%,transparent 47% 55%,#4f3422 56% 66%,transparent 67%),linear-gradient(145deg,#61452f,#1f1711)}
  @media(max-width:749px){#shop-fragrances-{{ section.id }}{padding-top:3.2rem}.inspo-tabs{justify-content:flex-start;margin-bottom:2.5rem}.inspo-tab{font-size:1rem;padding:.9rem 1.3rem}.inspo-finder{padding:2rem 1.4rem;border-radius:1.4rem}.inspo-choices,.inspo-choices--three{grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}.inspo-choice>span:last-child{padding:1rem;font-size:1.12rem}.inspo-result__cards{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:1rem;padding:.2rem .2rem 1rem}.inspo-result-card{flex:0 0 78%;scroll-snap-align:start}.inspo-result-card__media{aspect-ratio:4/5}.inspo-note-scenes{grid-template-columns:repeat(2,1fr)}.inspo-accords{padding:5rem 0}.inspo-accords h2{font-size:3.2rem}}

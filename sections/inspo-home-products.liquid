</style>

<script>
(() => {
  const root = document.getElementById('shop-fragrances-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const tabs = [...root.querySelectorAll('.inspo-tab')];
  const panels = [...root.querySelectorAll('.inspo-panel')];
  tabs.forEach(tab => tab.addEventListener('click', () => {
    tabs.forEach(t => { t.classList.toggle('is-active', t === tab); t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
    panels.forEach(panel => { const active = panel.id === tab.dataset.panel; panel.hidden = !active; panel.classList.toggle('is-active', active); });
  }));

  if (window.location.pathname === '/pages/scent-finder') {
    const finderTab = tabs.find(tab => tab.dataset.panel.startsWith('finder-'));
    if (finderTab) finderTab.click();
  }

  const quiz = root.querySelector('[data-inspo-quiz]');
  if (!quiz) return;
  const questions = [...quiz.querySelectorAll('[data-question]')];
  const progress = quiz.querySelector('.inspo-quiz__progress span');
  const result = quiz.querySelector('[data-result]');
  const products = [...quiz.querySelectorAll('[data-product]')];
  const answers = [];
  let step = 0;

  const scoreProduct = (product, terms) => {
    const haystack = `${product.dataset.title || ''} ${product.dataset.tags || ''}`;
    return terms.reduce((score, term) => score + (haystack.includes(term) ? 2 : 0), 0);
  };
  const showStep = index => {
    questions.forEach((q, i) => { q.hidden = i !== index; q.classList.toggle('is-active', i === index); });
    if (progress) progress.style.width = `${Math.min(100, ((index + 1) / 3) * 100)}%`;
  };
  const showResults = () => {
    questions.forEach(q => q.hidden = true);
    const terms = answers.join(' ').toLowerCase().split(/\s+/).filter(Boolean);
    const ranked = products.map((product, index) => ({ product, index, score: scoreProduct(product, terms) }))
      .sort((a, b) => b.score - a.score || a.index - b.index);
    products.forEach(p => p.hidden = true);
    const picks = ranked.slice(0, 3);
    picks.forEach(({ product }) => product.hidden = false);
    result.hidden = false;
    if (progress) progress.style.width = '100%';
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  quiz.querySelectorAll('.inspo-choice').forEach(choice => choice.addEventListener('click', () => {
    answers[step] = choice.dataset.answer || '';
    if (step < questions.length - 1) { step += 1; showStep(step); }
    else showResults();
  }));

  quiz.querySelector('[data-restart]')?.addEventListener('click', () => {
    answers.length = 0; step = 0; result.hidden = true; showStep(0);
  });
})();
</script>


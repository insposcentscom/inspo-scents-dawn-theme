  .inspo-panel[hidden],.inspo-question[hidden],.inspo-result[hidden]{display:none!important}.inspo-panel .product-grid{row-gap:3.5rem}.inspo-empty{padding:5rem 2rem;text-align:center;border:1px solid rgba(37,28,17,.12)}
  .inspo-finder{max-width:1120px;margin:auto;padding:clamp(2.2rem,5vw,5.5rem);border:1px solid rgba(181,132,48,.26);border-radius:2rem;background:#fffaf1;box-shadow:0 12px 40px rgba(48,34,16,.05)}
  .inspo-finder__intro{max-width:760px;margin:0 auto 3rem;text-align:center}.inspo-quiz__progress{height:3px;background:rgba(37,28,17,.09);margin:0 0 3.2rem;overflow:hidden}.inspo-quiz__progress span{display:block;width:33.333%;height:100%;background:#b78a3c;transition:width .3s ease}
  .inspo-question h3,.inspo-result h3{margin:.5rem 0 2.2rem;text-align:center;color:#251c11;font-size:clamp(2.3rem,4vw,3.8rem)}.inspo-question__count{color:#946a27;font-size:1.1rem;font-weight:700;letter-spacing:.13em;text-align:center;text-transform:uppercase}
  .inspo-choices{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}.inspo-choices--three{grid-template-columns:repeat(3,minmax(0,1fr))}.inspo-choice{appearance:none;overflow:hidden;padding:0;border:1px solid rgba(37,28,17,.12);border-radius:1.4rem;background:#f4ecdf;cursor:pointer;color:#251c11;font:inherit;font-size:1.25rem;font-weight:700;text-align:left;transition:.2s ease}.inspo-choice:hover{border-color:#bd8e3e;box-shadow:0 10px 28px rgba(48,34,16,.08);transform:translateY(-3px)}.inspo-choice>span:last-child{display:block;padding:1.25rem 1.35rem}

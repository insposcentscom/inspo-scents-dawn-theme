  #shop-fragrances-{{ section.id }} .inspo-shop__header{max-width:760px;margin:0 auto 3rem;text-align:center}
  #shop-fragrances-{{ section.id }} .inspo-shop__header h2,#shop-fragrances-{{ section.id }} .inspo-finder h2{margin:.6rem 0 1rem;color:#22180f;font-size:clamp(3rem,5vw,5.2rem);line-height:1.04;letter-spacing:-.035em}
  .inspo-eyebrow{margin:0;color:#9a6d24;font-size:1.05rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
  .inspo-tabs{display:flex;justify-content:center;gap:.8rem;margin:0 auto 3.4rem;overflow-x:auto;padding:.3rem;scrollbar-width:none}.inspo-tabs::-webkit-scrollbar{display:none}
  .inspo-tab{position:relative;z-index:2;touch-action:manipulation;pointer-events:auto;appearance:none;border:1px solid rgba(37,28,17,.2);border-radius:99px;background:rgba(255,255,255,.24);color:#2a1f13;cursor:pointer;flex:0 0 auto;font:inherit;font-size:1.15rem;font-weight:700;letter-spacing:.08em;padding:1rem 1.9rem;transition:.2s ease}

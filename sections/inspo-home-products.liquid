  .inspo-art--day,.inspo-art--night,.inspo-art--refined,.inspo-art--celebrate{background-image:url('https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-scent-finder-settings.png?v=1789452484');background-size:200% 200%}

  .inspo-art--celebrate{background:linear-gradient(145deg,#2f1f32,#9d4f47)}.inspo-art--celebrate:before{inset:0;background:radial-gradient(circle at 20% 30%,#e4c16d 0 2%,transparent 2.4%),radial-gradient(circle at 70% 18%,#f3d58a 0 2%,transparent 2.4%),radial-gradient(circle at 52% 58%,#f4c969 0 2%,transparent 2.4%),radial-gradient(circle at 84% 65%,#e9c782 0 2%,transparent 2.4%)}.inspo-art--celebrate:after{width:26%;height:42%;left:37%;bottom:16%;border-radius:8px 8px 18px 18px;background:linear-gradient(#f5d899,#b78a45)}
  .inspo-art--soft{background:radial-gradient(circle at 50% 50%,#fffaf1,#d8c8b3)}.inspo-art--soft:before{width:42%;height:42%;border-radius:50%;left:29%;top:29%;background:radial-gradient(circle,rgba(255,255,255,.95),rgba(226,211,193,.4));box-shadow:0 0 2rem rgba(255,255,255,.8)}
  .inspo-art--balanced{background:linear-gradient(145deg,#d5dccb,#8c9a78)}.inspo-art--balanced:before,.inspo-art--balanced:after{width:28%;height:52%;bottom:18%;border-radius:100% 0 100% 0;background:#5f7854}.inspo-art--balanced:before{left:28%;transform:rotate(-28deg)}.inspo-art--balanced:after{right:24%;transform:scaleX(-1) rotate(-28deg)}
  .inspo-art--bold{background:radial-gradient(circle at 50% 70%,#9b5c24,#23170f 70%)}.inspo-art--bold:before{width:32%;height:54%;left:34%;bottom:16%;background:linear-gradient(#d7aa62,#6c3e1d);clip-path:polygon(50% 0,88% 28%,100% 100%,0 100%,12% 28%)}.inspo-art--bold:after{inset:0;background:radial-gradient(circle at 50% 58%,rgba(244,190,94,.42),transparent 22%)}

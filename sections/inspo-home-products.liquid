  .inspo-art--citrus,.inspo-art--amber,.inspo-art--woods,.inspo-art--fruit{background-image:url('https://cdn.shopify.com/s/files/1/1021/5928/6565/files/inspo-scent-finder-families.png?v=1789452493');background-size:200% 200%}

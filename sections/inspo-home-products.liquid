{% comment %}
  Inspo Scents product-first homepage with collection tabs and guided scent finder.
{% endcomment %}

<section class="inspo-shop" id="shop-fragrances-{{ section.id }}">
  {%- liquid
    assign all_collection = section.settings.all_collection
    if all_collection == blank
      assign all_collection = collections['50-ml-fragrances']
    endif
    if all_collection == blank
      assign all_collection = collections.all
    endif

    assign mens_collection = section.settings.mens_collection
    if mens_collection == blank
      assign mens_collection = collections['men-s-fragrances']
    endif
    if mens_collection == blank
      assign mens_collection = all_collection
    endif

    assign womens_collection = section.settings.womens_collection
    if womens_collection == blank
      assign womens_collection = collections['women-s-fragrances']
    endif
    if womens_collection == blank
      assign womens_collection = all_collection
    endif
  -%}

  <div class="page-width">
    <header class="inspo-shop__header">
      <p class="inspo-eyebrow">Luxury-inspired fragrance</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.subheading | escape }}</p>
    </header>

    <div class="inspo-tabs" role="tablist" aria-label="Shop fragrances">
      <button class="inspo-tab is-active" type="button" role="tab" aria-selected="true" data-panel="all-{{ section.id }}">ALL</button>
      <button class="inspo-tab" type="button" role="tab" aria-selected="false" data-panel="men-{{ section.id }}">MEN</button>
      <button class="inspo-tab" type="button" role="tab" aria-selected="false" data-panel="women-{{ section.id }}">WOMEN</button>
      <button class="inspo-tab inspo-tab--finder" type="button" role="tab" aria-selected="false" data-panel="finder-{{ section.id }}">SCENT FINDER</button>
    </div>

    {%- assign collection_keys = 'all,men,women' | split: ',' -%}
    {%- for key in collection_keys -%}
      {%- case key -%}
        {%- when 'men' -%}{%- assign featured = mens_collection -%}
        {%- when 'women' -%}{%- assign featured = womens_collection -%}
        {%- else -%}{%- assign featured = all_collection -%}
      {%- endcase -%}
      <div class="inspo-panel{% if key == 'all' %} is-active{% endif %}" id="{{ key }}-{{ section.id }}" role="tabpanel" {% unless key == 'all' %}hidden{% endunless %}>
        {%- if featured.products_count > 0 -%}
          <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
            {%- for product in featured.products limit: section.settings.products_to_show -%}
              <li class="grid__item">
                <article class="inspo-product-card">
                  <a class="inspo-product-card__media" href="{{ product.url }}">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title, widths: '260, 420, 620, 900', sizes: '(max-width: 749px) 46vw, 23vw' }}
                    {%- endif -%}
                  </a>
                  <div class="inspo-product-card__details">
                    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                    <p>{{ product.price | money_with_currency }}</p>
                    {%- assign selected_variant = product.selected_or_first_available_variant -%}
                    {%- form 'product', product -%}
                      <input type="hidden" name="id" value="{{ selected_variant.id }}">
                      <button class="button button--secondary" type="submit" name="add" {% unless selected_variant.available %}disabled{% endunless %}>
                        {%- if selected_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </button>
                    {%- endform -%}
                  </div>
                </article>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="inspo-empty"><h3>Fragrances coming soon</h3><p>Add products to this collection in Shopify to display them here.</p></div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    <div class="inspo-panel inspo-finder" id="finder-{{ section.id }}" role="tabpanel" hidden>
      <div class="inspo-finder__intro">
        <p class="inspo-eyebrow">Personal scent matching</p>
        <h2>Find a scent built around your taste</h2>
        <p>Choose the accords, setting and intensity that feel most like you. We’ll surface the strongest matches from the Inspo Scents collection.</p>
      </div>

      <div class="inspo-quiz" data-inspo-quiz>
        <div class="inspo-quiz__progress" aria-hidden="true"><span></span></div>

        <div class="inspo-question is-active" data-question="0">
          <p class="inspo-question__count">Question 1 of 3</p>
          <h3>Which accord draws you in first?</h3>
          <div class="inspo-choices">
            <button class="inspo-choice" type="button" data-answer="fresh citrus bergamot aquatic clean">
              <span class="inspo-choice__art inspo-art--citrus" aria-hidden="true"><i></i><b></b><em></em></span><span>Fresh Citrus</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="sweet vanilla amber gourmand warm">
              <span class="inspo-choice__art inspo-art--amber" aria-hidden="true"><i></i><b></b><em></em></span><span>Warm Amber</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="woody oud cedar leather smoky">
              <span class="inspo-choice__art inspo-art--woods" aria-hidden="true"><i></i><b></b><em></em></span><span>Deep Woods</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="fruity apple berry pear floral bright">
              <span class="inspo-choice__art inspo-art--fruit" aria-hidden="true"><i></i><b></b><em></em></span><span>Juicy Fruit</span>
            </button>
          </div>
        </div>

        <div class="inspo-question" data-question="1" hidden>
          <p class="inspo-question__count">Question 2 of 3</p>
          <h3>Where should the scent feel most at home?</h3>
          <div class="inspo-choices">
            <button class="inspo-choice" type="button" data-answer="versatile daily clean fresh">
              <span class="inspo-choice__art inspo-art--day" aria-hidden="true"><i></i><b></b><em></em></span><span>Every Day</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="date night sexy warm amber sweet">
              <span class="inspo-choice__art inspo-art--night" aria-hidden="true"><i></i><b></b><em></em></span><span>Date Night</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="refined elegant woody aromatic office">
              <span class="inspo-choice__art inspo-art--refined" aria-hidden="true"><i></i><b></b><em></em></span><span>Work & Events</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="bold statement intense fruity celebration">
              <span class="inspo-choice__art inspo-art--celebrate" aria-hidden="true"><i></i><b></b><em></em></span><span>Celebrations</span>
            </button>
          </div>
        </div>

        <div class="inspo-question" data-question="2" hidden>
          <p class="inspo-question__count">Question 3 of 3</p>
          <h3>How much presence do you want?</h3>
          <div class="inspo-choices inspo-choices--three">
            <button class="inspo-choice" type="button" data-answer="soft subtle musk skin clean">
              <span class="inspo-choice__art inspo-art--soft" aria-hidden="true"><i></i><b></b><em></em></span><span>Soft & Close</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="balanced versatile aromatic noticeable">
              <span class="inspo-choice__art inspo-art--balanced" aria-hidden="true"><i></i><b></b><em></em></span><span>Noticeable</span>
            </button>
            <button class="inspo-choice" type="button" data-answer="intense strong oud amber elixir bold lasting">
              <span class="inspo-choice__art inspo-art--bold" aria-hidden="true"><i></i><b></b><em></em></span><span>Bold & Lasting</span>
            </button>
          </div>
        </div>

        <div class="inspo-result" data-result hidden>
          <p class="inspo-eyebrow">Your match</p>
          <h3 data-result-heading>Top matches for you</h3>
          <p class="inspo-result__note">Based on the notes and style you selected.</p>
          <div class="inspo-result__cards">
            {%- for product in all_collection.products limit: 30 -%}
              <a class="inspo-result-card" href="{{ product.url }}" data-product data-title="{{ product.title | downcase | escape }}" data-tags="{{ product.tags | join: ' ' | downcase | escape }}" hidden>
                <span class="inspo-result-card__media">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title, widths: '320, 480, 700, 900', sizes: '(max-width: 749px) 78vw, 28vw' }}
                  {%- endif -%}
                </span>
                <span class="inspo-result-card__title">{{ product.title }}</span>
                <strong>{{ product.price | money }}</strong>
              </a>
            {%- endfor -%}
          </div>
          <button class="button button--secondary" type="button" data-restart>Retake the quiz</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>

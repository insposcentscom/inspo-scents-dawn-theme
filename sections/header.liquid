      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }

    .inspo-header-search {
      padding-right: 1.2rem;
      padding-bottom: 0.8rem;
      padding-left: 1.2rem;
    }

    .inspo-inline-search__field {
      min-height: 4rem;
    }

    .inspo-inline-search__results .predictive-search__results-list {
      grid-template-columns: 1fr;
